# Backend Server Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Google Gemini API Key (Required for AI Semantic Verification)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=

# Firebase Admin Configuration (Optional: fallback to local JSON database if not configured)
# Path to service account JSON file, or raw JSON string
FIREBASE_SERVICE_ACCOUNT_KEY=
# Or individual fields:
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
